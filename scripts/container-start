#!/bin/sh
# Starts (or on first run creates) a Lima VM named "nto" that provides Docker for local Supabase.
# Requires limactl on PATH or under NTO_CONTAINER_BIN. Docker Desktop users do not need this script.
set -eu
NTO_CONTAINER_BIN="${NTO_CONTAINER_BIN:-$HOME/.local/share/nto/toolchains/containers/bin}"
if [ -d "$NTO_CONTAINER_BIN" ]; then export PATH="$NTO_CONTAINER_BIN:$PATH"; fi
NTO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -f "$HOME/.lima/nto/lima.yaml" ]; then
  exec limactl start nto --tty=false
fi
exec limactl start --name=nto --vm-type=vz --cpus=4 --memory=6 --disk=30 --mount-only "$NTO_ROOT:w" --tty=false template:docker
